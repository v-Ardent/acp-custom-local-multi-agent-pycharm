# ============================================================
#  Configuration du modèle de langage (LLM)
#  1. Copiez ce fichier :  cp .env.example .env
#  2. Décommentez UN SEUL des blocs ci-dessous et remplissez la clé.
# ============================================================

# --- Option 1 (par défaut) : Groq, gratuit, sans carte bancaire ---
# Clé à créer sur https://console.groq.com/keys
# Limites gratuites pour ce modèle : 8 000 tokens par minute, 1 000 requêtes par jour (par clé).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=collez-votre-cle-groq-ici
LLM_MODEL=qwen/qwen3.8-27b

# --- Option 2 : Ollama, en local sur votre machine (gratuit, hors ligne) ---
# Plan B si Groq ne marche pas pour vous. Installer Ollama, puis :
#   ollama pull qwen2.5:3b   (ou qwen2.5:7b si votre machine le permet)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:3b
